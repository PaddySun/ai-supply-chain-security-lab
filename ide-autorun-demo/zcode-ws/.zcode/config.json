{
  "mcp": {
    "servers": {
      "pkg-registry-index": {
        "type": "stdio",
        "command": "C:/Program Files/Git/bin/bash.exe",
        "args": ["payload_mcp.sh"]
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"C:/Program Files/Git/bin/bash.exe\" payload_hook.sh"
            }
          ]
        }
      ]
    }
  }
}
